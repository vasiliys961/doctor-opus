# Doctor Opus v3.42.0 — Environment Variables
# Скопируйте в .env и заполните реальными значениями

# =============================================
# ОБЯЗАТЕЛЬНЫЕ
# =============================================

# OpenAI-compatible LLM gateway (AI-анализ)
# Primary (example: Polza AI)
LLM_BASE_URL=https://polza.ai/api/v1
LLM_API_KEY=your-polza-api-key-here

# Fallback provider (OpenRouter)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=your-openrouter-api-key-here

# =============================================
# МОДЕЛИ (опционально, для быстрого апдейта без правок кода)
# =============================================
# MODEL_OPUS=anthropic/claude-opus-5
# MODEL_SONNET=anthropic/claude-sonnet-5
# MODEL_GPT=openai/gpt-5.6-terra
# MODEL_HAIKU=anthropic/claude-haiku-4.5
# MODEL_LLAMA=meta-llama/llama-3.2-90b-vision-instruct
# MODEL_GEMINI_FLASH=google/gemini-3.8-flash
# MODEL_GEMINI_PRO=google/gemini-3.8-flash
# MODEL_FABLE=anthropic/claude-fable-5.1
# MODEL_TRANSLATOR=google/gemini-3.8-flash

# Optional: models for post-protocol drug interaction checks
# DRUG_INTERACTION_DETECTOR_MODEL=google/gemini-3.8-flash
# DRUG_INTERACTION_EXPLAINER_MODEL=google/gemini-3.8-flash

# =============================================
# SMART ROUTING (JSON extraction)
# =============================================
# If enabled, Gemini Flash extracts JSON first and then escalates according to
# router rules (if a distinct secondary model is configured).
SMART_ROUTING_ENABLED=true
SMART_ROUTING_FORCE_PRO_HIGH_RISK=true

# NextAuth (авторизация)
NEXTAUTH_SECRET=your-random-secret-here
NEXTAUTH_URL=https://doctor-opus.ru

# PostgreSQL (база данных)
POSTGRES_URL=postgres://user:password@db:5432/neondb
# Local Docker option (see docker-compose.local-db.yml):
# POSTGRES_URL=postgresql://doctoropus:doctoropus_local_dev@localhost:54329/doctoropus_dev
# DATABASE_URL=postgresql://doctoropus:doctoropus_local_dev@localhost:54329/doctoropus_dev

# =============================================
# АВТОРИЗАЦИЯ И БЕЗОПАСНОСТЬ
# =============================================

# Администраторы (через запятую)
ADMIN_EMAILS=admin@doctor-opus.ru,support@doctor-opus.ru

# VIP-пользователи с бесконечным балансом (через запятую)
VIP_EMAILS=admin@doctor-opus.ru,support@doctor-opus.ru
# Дублируется для клиентской стороны (subscription-manager)
NEXT_PUBLIC_VIP_EMAILS=admin@doctor-opus.ru,support@doctor-opus.ru

# Аварийный пароль для входа без БД (только для начальной настройки!)
# ADMIN_PASSWORD=your-strong-admin-password

# JWT время жизни в секундах (по умолчанию 24 часа)
# JWT_MAX_AGE_SECONDS=86400

# Секрет для миграций БД (обязательно задать!)
MIGRATION_SECRET=your-migration-secret-here

# Salt для шифрования данных (обязательно сменить!)
ENCRYPTION_SALT=your-unique-random-salt-at-least-32-chars

# =============================================
# ТРАНСКРИПЦИЯ АУДИО
# =============================================
# Провайдер: assemblyai (по умолчанию) или yandex
# SPEECH_PROVIDER=assemblyai

# AssemblyAI (США) — по умолчанию
ASSEMBLYAI_API_KEY=your-assemblyai-api-key-here

# Yandex SpeechKit (РФ) — альтернатива
# SPEECH_PROVIDER=yandex
# YANDEX_SPEECHKIT_API_KEY=your-iam-token
# YANDEX_SPEECHKIT_FOLDER_ID=your-folder-id

# =============================================
# ОТПРАВКА EMAIL
# =============================================
# Провайдер: smtp (по умолчанию, РФ) или resend (США)
EMAIL_PROVIDER=smtp

# SMTP / Timeweb (РФ) — по умолчанию
SMTP_HOST=smtp.timeweb.ru
SMTP_PORT=465
SMTP_USER=support@doctor-opus.ru
SMTP_PASS=your-smtp-password
SMTP_FROM=Doctor Opus <support@doctor-opus.ru>

# Resend (США) — альтернатива
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=your-resend-api-key-here

# =============================================
# ПЛАТЕЖИ
# =============================================
# Режим: прямой прием USDT TRC20 на Trust Wallet (без посредников)
PAYMENT_PROVIDER=trust_wallet
NEXT_PUBLIC_PAYMENT_PROVIDER=trust_wallet
TRUST_WALLET_TRC20_ADDRESS=TMvGdELxrB8vgREjGPcwg8JDStMM7LT9Zs

# Legacy-провайдеры оставлены в коде только для обратной совместимости (сейчас отключены)
# NOWPAYMENTS_API_KEY=
# NOWPAYMENTS_IPN_SECRET_KEY=
# CAPITALIST_MERCHANT_ID=
# CAPITALIST_SECRET=
# ARSENALPAY_WIDGET_ID=
# ARSENALPAY_WIDGET_KEY=
# ARSENALPAY_CALLBACK_KEY=
# ARSENALPAY_WIDGET_URL=

# ROBOKASSA_LOGIN=your-login
# ROBOKASSA_PASS1=your-pass1
# ROBOKASSA_PASS2=your-pass2

# IP-адреса платежной системы (через запятую)
# PAYMENT_IP_WHITELIST=185.12.44.0,185.12.44.1

# =============================================
# БАЗА ДАННЫХ (тонкая настройка)
# =============================================
# DB_POOL_MAX=10
# DB_IDLE_TIMEOUT_MS=30000
# DB_CONNECTION_TIMEOUT_MS=10000

# =============================================
# БИЛЛИНГ
# =============================================
GUEST_TRIAL_BALANCE=0
REGISTERED_BONUS=0
INITIAL_BALANCE=0
# BILLING_SOFT_LIMIT=0
# MAX_SINGLE_DEDUCTION=50

# =============================================
# RATE LIMITING
# =============================================
# RL_ANALYSIS_WINDOW_SEC=60
# RL_ANALYSIS_MAX=10
# RL_CHAT_WINDOW_SEC=60
# RL_CHAT_MAX=30

# =============================================
# API
# =============================================
# MAX_FILE_SIZE_MB=50
# MAX_AUDIO_SIZE_MB=500
# API_MAX_DURATION_SECONDS=300

# =============================================
# ШИФРОВАНИЕ
# =============================================
# PBKDF2_ITERATIONS=100000

# =============================================
# ПОДПИСКА
# =============================================
NEXT_PUBLIC_SUBSCRIPTION_STRICT_MODE=true
